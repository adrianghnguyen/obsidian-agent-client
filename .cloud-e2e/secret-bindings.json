      "pointer": {
        "pluginId": "agent-client",
        "path": ["presetAgents", "codex-acp", "apiKeySecretId"]
      }
    },
    {
      "cursorEnv": "GEMINI_API_KEY",
      "secretStorageId": "gemini-api-key",
